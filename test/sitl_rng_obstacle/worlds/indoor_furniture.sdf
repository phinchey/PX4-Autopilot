<?xml version="1.0" encoding="UTF-8"?>
<!--
  Indoor house with furniture for the PX4 range-finder height reference test
  (test/sitl_rng_obstacle).  Physics, scene, light and spherical coordinates
  are copied from Tools/simulation/gz/worlds/default.sdf.  The textured floor
  comes from the indoor_house model (test/sitl_rng_obstacle/models).

  Layout (x east, y north, metres; 0.15 m walls, 2.6 m high; doors 2.0 x 2.3 m):
    living room  x[-10,0] y[0,7]   kitchen  x[-10,0] y[-7,0]
    hallway      x[0,3]   y[-7,7]
    bedroom      x[3,10]  y[0,7]   study    x[3,10]  y[-7,0]
  Spawn point: (-8.5, 1.5) in the living room.  Flight route (fly_furniture.py)
  at 1.5 m: over the step, through the hallway doors, over the bed and back,
  then over the dining table, coffee table and couch, a hover above the
  dining table, and back to the spawn point.  Nothing taller than 1.2 m is closer
  than 0.6 m to the route, and the route keeps >= 1.3 m from every wall because
  the flow/range position estimate drifts by up to ~1 m per furniture pass.

  Generated once by a helper script; edit by hand if needed.
-->
<sdf version="1.9">
  <world name="indoor_furniture">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <!-- Brighter than default.sdf: the flow camera needs contrast indoors.
           Light from straight above with shadows on gave the most accurate
           optical flow of the lighting variants tried (angled light without
           shadows was clearly worse over the furniture). -->
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <!-- straight down so the 2.6 m walls do not shadow the floor -->
      <direction>0.0 0.0 -1.0</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- textured floor -->
    <include>
      <uri>model://indoor_house</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- ============ outer walls (2.6 m high) ============ -->
    <model name="wall_south">
      <static>true</static>
      <link name="seg0">
        <pose>0.000 -7.000 1.300 0 0 0.000</pose>
        <collision name="col"><geometry><box><size>20.000 0.150 2.600</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>20.000 0.150 2.600</size></box></geometry>
          <material><ambient>0.92 0.9 0.85 1</ambient><diffuse>0.92 0.9 0.85 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
