<?xml version="1.0"?>
<!-- Two static cameras used by fly_furniture.py --video. Poses are in the
     world frame (the model is spawned at the origin). -->
<sdf version="1.9">
  <model name="flight_cameras">
    <static>true</static>
    <link name="wide_link">
      <pose>-0.6 0.6 2.35 0 0.263 2.649</pose>
      <sensor name="wide" type="camera">
        <camera>
          <horizontal_fov>1.75</horizontal_fov>
          <image><width>960</width><height>540</height></image>
          <clip><near>0.05</near><far>60</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>/video/wide/image</topic>
        <plugin filename="gz-sim-camera-video-recorder-system" name="gz::sim::systems::CameraVideoRecorder">
          <service>/video/wide/record</service>
          <use_sim_time>true</use_sim_time>
          <fps>15</fps>
          <bitrate>4000000</bitrate>
        </plugin>
      </sensor>
    </link>
    <link name="side_link">
      <pose>-5.0 0.35 1.05 0 0.05 1.5708</pose>
      <sensor name="side" type="camera">
        <camera>
          <horizontal_fov>2.1</horizontal_fov>
          <image><width>960</width><height>540</height></image>
          <clip><near>0.05</near><far>60</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>/video/side/image</topic>
        <plugin filename="gz-sim-camera-video-recorder-system" name="gz::sim::systems::CameraVideoRecorder">
          <service>/video/side/record</service>
          <use_sim_time>true</use_sim_time>
          <fps>15</fps>
          <bitrate>4000000</bitrate>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
